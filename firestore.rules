rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public survey: anyone may read aggregated responses and add a new one.
    // Existing records cannot be edited or deleted from the client.
    match /{collection}/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
